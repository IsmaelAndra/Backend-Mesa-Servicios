# Copia este archivo como .env (en el servidor interno) y complétalo.
# El .env tiene contraseñas: no lo subas a git.

# API de la mesa de servicios (con /api al final).
MESA_URL=https://mesa-servicios.coacmagisterio.fin.ec/api

# Token compartido con el backend: el MISMO valor que TELEFONIA_PUENTE_TOKEN
# en el .env del servidor de la mesa. Mínimo 32 caracteres; genéralo con
#   openssl rand -hex 32
PUENTE_TOKEN=

# API de la central Grandstream UCM (red interna, puerto 8089 por defecto).
UCM_URL=https://192.168.1.235:8089/api

# Usuario creado en la UCM → Integrations → API Configuration, con solo el
# permiso dialExtension marcado y la IP de ESTE servidor en las permitidas.
UCM_USUARIO=
UCM_CLAVE=

# Cada cuánto pregunta por llamadas pendientes (milisegundos).
INTERVALO_MS=2000
