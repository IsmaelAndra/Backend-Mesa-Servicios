# Copia este archivo como .env (en el servidor interno) y complétalo.
# El .env tiene el token del puente: no lo subas a git ni lo compartas.
#
# El resto (URL, usuario y clave de la API de la UCM) se configura en la mesa:
# Administración → Telefonía.

# API de la mesa de servicios (con /api al final).
MESA_URL=https://mesa-servicios.coacmagisterio.fin.ec/api

# Token del puente: Administración → Telefonía → "Generar token".
# Se muestra una sola vez; si se pierde, genera otro (el anterior deja de valer).
PUENTE_TOKEN=
