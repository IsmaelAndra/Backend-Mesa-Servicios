<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="agentes" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="555" leftMargin="40" rightMargin="40" topMargin="30" bottomMargin="30"
              whenNoDataType="NoPages" language="java">

    <parameter name="TITULO" class="java.lang.String" isForPrompting="false"/>
    <parameter name="FECHA" class="java.lang.String" isForPrompting="false"/>
    <parameter name="TOTAL" class="java.lang.Integer" isForPrompting="false"/>

    <field name="id" class="java.lang.Object"/>
    <field name="titulo" class="java.lang.Object"/>
    <field name="usuario" class="java.lang.Object"/>
    <field name="agente" class="java.lang.Object"/>
    <field name="area" class="java.lang.Object"/>
    <field name="categoria" class="java.lang.Object"/>
    <field name="estado" class="java.lang.Object"/>
    <field name="prioridad" class="java.lang.Object"/>
    <field name="fecha" class="java.lang.Object"/>

    <!-- Título -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="762" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Rendimiento de Agentes]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="24" width="762" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{area} == null ? "" : "Generado: " + $P{FECHA} + "  |  Total tickets: " + $P{TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Encabezados de columna -->
    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement x="0" y="0" width="40" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="40" y="0" width="160" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Título]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="120" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Usuario]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="90" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Área]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="110" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Categoría]]></text>
            </staticText>
            <staticText>
                <reportElement x="520" y="0" width="90" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="70" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Prioridad]]></text>
            </staticText>
            <staticText>
                <reportElement x="680" y="0" width="82" height="24"/>
                <textElement verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalle -->
    <detail>
        <band height="20">
            <line><reportElement x="0" y="19" width="762" height="1"/></line>
            <textField><reportElement x="0" y="0" width="40" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{id} == null ? "" : $F{id}]]></textFieldExpression></textField>
            <textField><reportElement x="40" y="0" width="160" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{titulo} == null ? "" : $F{titulo}]]></textFieldExpression></textField>
            <textField><reportElement x="200" y="0" width="120" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{usuario} == null ? "" : $F{usuario}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="0" width="90" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{area} == null ? "" : $F{area}]]></textFieldExpression></textField>
            <textField><reportElement x="410" y="0" width="110" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{categoria} == null ? "" : $F{categoria}]]></textFieldExpression></textField>
            <textField><reportElement x="520" y="0" width="90" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{estado} == null ? "" : $F{estado}]]></textFieldExpression></textField>
            <textField><reportElement x="610" y="0" width="70" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{prioridad} == null ? "" : $F{prioridad}]]></textFieldExpression></textField>
            <textField><reportElement x="680" y="0" width="82" height="19"/><textElement verticalAlignment="Middle"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{fecha} == null ? "" : $F{fecha}]]></textFieldExpression></textField>
        </band>
    </detail>

    <!-- Resumen -->
    <summary>
        <band height="30">
            <textField>
                <reportElement x="0" y="10" width="762" height="20"/>
                <textElement textAlignment="Right"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total de tickets: " + $P{TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>