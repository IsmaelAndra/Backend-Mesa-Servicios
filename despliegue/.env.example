# ==============================================================================
# MESA DE SERVICIOS COAC: VARIABLES PARA DOCKER COMPOSE
# ==============================================================================
# Sirve igual en tu PC (construir y probar) y en el servidor (producción):
#   1. Copia este archivo a .env en esta misma carpeta:   cp .env.example .env
#   2. Rellena lo marcado como OBLIGATORIO.
#   3. En el servidor:  chmod 600 .env   (solo lo lee el dueño: contiene claves)
#
# Los valores de aquí son de EJEMPLO y no sirven: genera los tuyos.
# El .env real NUNCA se sube al repositorio (.gitignore ya lo excluye) ni entra
# en las imágenes (.dockerignore). DB_HOST, DB_PORT, SPRING_PROFILES_ACTIVE=prod,
# UPLOAD_DIR y APP_TRUST_FORWARDED_HEADERS los fijan los docker-compose.
# ==============================================================================

# ---------- Imágenes (GitHub Container Registry) ----------
# Usuario u organización de GitHub dueño de las imágenes, EN MINÚSCULAS.
# Quedan como ghcr.io/<GHCR_OWNER>/mesa-servicios-backend:<VERSION>.
GHCR_OWNER=ismaelandra
# Versión a construir (en tu PC) o a desplegar (en el servidor). Usa números
# (1.1.0, 1.1.1...): para volver atrás basta con poner aquí la anterior.
VERSION=1.1.0

# ---------- Solo en el SERVIDOR ----------
# Con esto, "docker compose ..." usa el archivo de producción sin poner -f.
# En tu PC déjalo comentado (se usa docker-compose.yml, el que construye).
# COMPOSE_FILE=docker-compose.prod.yml
# Red de Docker donde está el Nginx del servidor (ya existe; ver README.md).
PROXY_NETWORK=proxy
# Red desde la que llega ese Nginx: de ahí se acepta X-Forwarded-For para
# saber la IP real de cada usuario. 172.16.0.0/12 cubre las redes de Docker por
# defecto; compruébalo con:  docker network inspect <PROXY_NETWORK>
REAL_IP_FROM=172.16.0.0/12

# ---------- Solo en tu PC ----------
# Carpeta del repo del frontend, relativa a esta carpeta (para construir).
FRONTEND_DIR=../../Frontend-Mesa-Servicios
# Puerto para probar en tu PC: http://localhost:8088 (solo en 127.0.0.1).
HTTP_PORT_LOCAL=8088

# ---------- Base de datos (contenedor "db") ----------
DB_DATABASE=mesa_ayuda_coac
DB_USERNAME=mesa_ayuda
# OBLIGATORIA. Genera una con:  openssl rand -base64 32 | tr -d '/+='
# Solo letras y números: evita problemas al copiarla en comandos.
DB_PASSWORD=

# ---------- JWT ----------
# OBLIGATORIA. 512 bits en base64:  openssl rand -base64 64 | tr -d '\n'
# Cambiarla cierra la sesión de todo el mundo.
JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# ---------- URLs públicas ----------
# OBLIGATORIAS. El dominio con el que entran los usuarios, con https.
# (Para probar en tu PC: http://localhost:8088 y http://localhost:8088/api.)
# Frontend y API van en el mismo dominio: la API cuelga de /api.
CORS_ORIGINS=https://soporte.ejemplo.fin.ec
# Logo, imágenes de branding y archivos públicos.
APP_PUBLIC_BASE_URL=https://soporte.ejemplo.fin.ec/api
# Enlaces de los correos (botones "Ver ticket", pie del correo). Sin /api.
APP_FRONTEND_BASE_URL=https://soporte.ejemplo.fin.ec

# ---------- Seguridad ----------
# Cookie del token de refresco solo por HTTPS. Déjalo en true: con false, en
# producción el token puede viajar en claro.
APP_SECURE_COOKIE=true
# Swagger publica el mapa completo de la API. Nunca en producción.
SWAGGER_ENABLED=false

# ---------- Cuentas administrativas iniciales ----------
# Solo en el PRIMER arranque con base vacía: crea SOLO el superadmin con esta
# contraseña y cambio obligatorio en el primer login (el resto de cuentas las
# crea él desde la aplicación). Si la cuenta ya existe, se ignora. Después del primer login, VACÍALA.
ADMIN_SEED_PASSWORD=
ADMIN_SEED_EMAIL=superadmin@coacmagisterio.fin.ec

# ---------- Microsoft Graph (correo y sincronización de usuarios) ----------
# Se pueden dejar vacías y configurarlo después en Admin → Microsoft Graph.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# OBLIGATORIA. Cifra los secretos que se guardan en la base desde la interfaz:
# el client_secret de Graph y la api key de la IA (MAPI).
#   openssl rand -base64 48 | tr -d '\n'
# NO la cambies después: esos secretos dejarían de poder descifrarse y habría
# que volver a escribirlos en Admin → Microsoft Graph y Admin → IA.
GRAPH_ENCRYPTION_KEY=

# ---------- Otros ----------
# Destinatarios del resumen diario (separados por coma). Vacío = no se envía.
DAILY_SUMMARY_RECIPIENTS=
