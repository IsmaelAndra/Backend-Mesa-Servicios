# ============================================================
# VARIABLES DE ENTORNO - MESA DE AYUDA COAC
# Copia este archivo a .env y completa los valores reales.
# JAMÁS comprometas el .env real en el repositorio.
# ============================================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=mesa_ayuda_coac
DB_USERNAME=postgres
# Obligatoria: la app no arranca sin esta clave
DB_PASSWORD=cambia_esta_clave

# --- JWT ---
# Obligatoria: secreto base64 de 512 bits (genera con: openssl rand -base64 64)
JWT_SECRET=genera_un_secreto_base64_de_64_bytes
# Acceso: 15 min. Refresh: 30 días.
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# --- Seguridad / entorno ---
# Perfil "dev" activa show-sql y health details; en producción NO definirlo
# Perfil de Spring. En PRODUCCIÓN debe ser "prod": ese perfil apaga Swagger,
# quita DEBUG del log, pone cabeceras de seguridad y deja de mostrar trazas en
# los errores. Sin él, se aplica application.yml a secas, que es configuración de
# desarrollo.
SPRING_PROFILES_ACTIVE=

# Publica Swagger UI (/api/swagger-ui.html) fuera del perfil dev. Nunca en produccion.
SWAGGER_ENABLED=false
CORS_ORIGINS=http://localhost:4200

# --- URLs públicas ---
# Base de la API: se usa para el logo y los archivos subidos.
APP_PUBLIC_BASE_URL=http://localhost:8080/api
# Base del FRONTEND: es la que usan los enlaces de los correos (botones CTA y
# pie "Sitio web"/"Soporte"). En producción pon aquí el dominio real de la SPA,
# sin /api; si se olvida, los correos salen con enlaces vacíos.
APP_FRONTEND_BASE_URL=http://localhost:4200

# --- Cuentas administrativas iniciales ---
# Se usa SOLO en el primer arranque, para crear el SUPER_ADMIN (la única cuenta
# sembrada: él crea el resto desde la aplicación). Si se deja vacía no se crea
# ninguna cuenta administrativa. Nace con cambio de contraseña obligatorio, así que no sirve para operar.
# En producción define una contraseña fuerte y cámbiala en el primer login.
# Va vacía a propósito: este archivo está en el repositorio, y una contraseña
# escrita aquí la conoce cualquiera que lo lea. Entre el despliegue y el primer
# login, quien la supiera podría entrar antes y fijar su propia contraseña.
ADMIN_SEED_PASSWORD=
ADMIN_SEED_EMAIL=superadmin@coacmagisterio.fin.ec

# --- Microsoft Graph (Outlook) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
# Clave maestra para cifrar el client_secret de Graph (AES-GCM).
# Genera con: openssl rand -base64 48
GRAPH_ENCRYPTION_KEY=

# --- Uploads ---
# Carpeta raiz de archivos subidos. Dentro hay dos zonas:
#   publico/   logo, icono del sistema, fondos del chat, logos de informe y
#              avatares. Se sirven sin sesion porque el login los necesita.
#   adjuntos/  archivos de los tickets. NO se sirven como estatico: van por
#              AttachmentController, que exige sesion y comprueba el permiso.
UPLOAD_DIR=./uploads

# Cookie de sesión del refresh token.
# false solo vale en http://localhost. Con HTTPS en producción, poner true:
# sin Secure, el token de refresco puede viajar en claro.
APP_SECURE_COOKIE=false

# Cabeceras de reenvio (X-Forwarded-For). Poner true SOLO si todas las peticiones
# entran por un proxy. Con true y el backend expuesto, cualquiera se inventa la IP
# y se salta los límites por origen.
APP_TRUST_FORWARDED_HEADERS=false

# --- Telefonía (central Grandstream UCM) ---
# Token que comparte el backend con el puente de telefonía (puente-telefonia/),
# que corre en un servidor interno. Mínimo 32 caracteres; genéralo con
#   openssl rand -hex 32
# Vacío = telefonía apagada (el botón Llamar no aparece).
TELEFONIA_PUENTE_TOKEN=
